# ═════════════════════════════════════════════════════════════
# Modèle de configuration — copier en backend/.env et remplir (TICK-068)
# backend/.env est ignoré par git : n'y mettez jamais de valeur dans ce fichier-ci.
# Docker : docker compose --env-file backend/.env up -d
# ═════════════════════════════════════════════════════════════

# Profil Spring : dev (défaut en local) | prod
# SPRING_PROFILES_ACTIVE=prod

# ── Base de données (PostgreSQL) ──────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/confiancecoursier
DB_USERNAME=confiance_coursier_user
DB_PASSWORD=

# ── JWT (clé Base64 d'au moins 256 bits : openssl rand -base64 48) ──
JWT_SECRET_KEY=

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── MinIO (stockage KYC et preuves) ───────────────────────────
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── Emails (Brevo) ────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_APP_NAME=ConfianceCoursier

# ── Frontend / CORS (plusieurs origines séparées par des virgules) ──
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Derrière un reverse proxy de confiance (nginx…) : true pour lire la vraie IP du client
TRUST_FORWARDED_FOR=false

# ── Compte administrateur initial (créé s'il n'existe aucun ADMIN) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
