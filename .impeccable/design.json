      "kind": "chip",
      "refersTo": "badge-succes",
      "description": "Statut de course, couleur et libellé issus de courseStatus.",
      "html": "<div class=\"ds-badges\"><span class=\"ds-badge ds-ok\">En cours</span><span class=\"ds-badge ds-warn\">Preuves à valider</span><span class=\"ds-badge ds-bad\">En retard</span></div>",
      "css": ".ds-badges{display:flex;gap:8px;flex-wrap:wrap}.ds-badge{display:inline-flex;align-items:center;min-height:24px;padding:2px 10px;border-radius:99px;font:700 12px Inter,system-ui,sans-serif}.ds-ok{background:#e4f3e9;color:#26845d}.ds-warn{background:#fff3dc;color:#a66b16}.ds-bad{background:#fbeae8;color:#b54843}"
    },
    {
