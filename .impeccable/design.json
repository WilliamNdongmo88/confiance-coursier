  "components": [
    {
      "name": "Bouton principal (application)",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Action principale d'un écran de l'application ; une seule par écran.",
      "html": "<button class=\"ds-btn-primary\">Payer et bloquer les fonds <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 19px;border-radius:9px;font:750 14px/1 Inter,system-ui,sans-serif;letter-spacing:-.012em;border:1px solid transparent;cursor:pointer;transition:background .2s,box-shadow .2s,transform .2s;min-height:48px;background:#17634f;color:#fff;box-shadow:0 4px 12px #123b3214}.ds-btn-primary:hover{background:#1b5144;transform:translateY(-1px);box-shadow:0 7px 18px #123b3224}.ds-btn-primary:focus-visible{outline:3px solid #2e705b;outline-offset:3px;}.ds-btn-primary:active{transform:none}"
    },
    {
      "name": "Bouton vert coffre (site public)",
      "kind": "button",
      "refersTo": "button-coffre",
      "description": "CTA du site public (Créer un compte, Confier une course).",
      "html": "<button class=\"ds-btn-coffre\">Confier une course <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5l7 7-7 7\"/></svg></button>",
      "css": ".ds-btn-coffre{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 19px;border-radius:9px;font:750 14px/1 Inter,system-ui,sans-serif;letter-spacing:-.012em;border:1px solid transparent;cursor:pointer;transition:background .2s,box-shadow .2s,transform .2s;background:#123b32;color:#fff;box-shadow:0 4px 12px #123b3214}.ds-btn-coffre:hover{background:#1b5144;transform:translateY(-1px);box-shadow:0 7px 18px #123b3224}.ds-btn-coffre:focus-visible{outline:3px solid #2e705b;outline-offset:3px;}"
    },
    {
      "name": "Bouton secondaire",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Action secondaire à côté du principal.",
      "html": "<button class=\"ds-btn-secondary\">Découvrir le service</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 19px;border-radius:9px;font:750 14px/1 Inter,system-ui,sans-serif;letter-spacing:-.012em;border:1px solid transparent;cursor:pointer;transition:background .2s,box-shadow .2s,transform .2s;background:#fff;color:#123b32;border-color:#dce4dd}.ds-btn-secondary:hover{background:#f2f6f1}.ds-btn-secondary:focus-visible{outline:3px solid #2e705b;outline-offset:3px;}"
    },
    {
      "name": "Bouton lime",
      "kind": "button",
      "refersTo": "button-lime",
      "description": "Signal sur fond vert coffre uniquement.",
      "html": "<div class=\"ds-band\"><button class=\"ds-btn-lime\">En savoir plus</button></div>",
      "css": ".ds-band{background:#153c32;padding:24px;border-radius:13px}.ds-btn-lime{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:46px;padding:0 19px;border-radius:9px;font:750 14px/1 Inter,system-ui,sans-serif;letter-spacing:-.012em;border:1px solid transparent;cursor:pointer;transition:background .2s,box-shadow .2s,transform .2s;background:#d7ed9a;color:#123b32}.ds-btn-lime:hover{background:#c8e480}.ds-btn-lime:focus-visible{outline:3px solid #d7ed9a;outline-offset:3px}"
    },
    {
      "name": "Champ",
      "kind": "input",
      "refersTo": "input",
      "description": "Champ de saisie standard, 44 px, texte 16 px.",
      "html": "<label class=\"ds-field\"><span>Achats à avancer (XAF)</span><input class=\"ds-input\" placeholder=\"15 000\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font:700 14px Inter,system-ui,sans-serif;color:#35473c}.ds-input{min-height:44px;padding:0 14px;border:1px solid #dce4dd;border-radius:8px;background:#fff;color:#15241f;font:400 16px Inter,system-ui,sans-serif}.ds-input::placeholder{color:#56635c}.ds-input:focus{outline:none;border-color:#76a789;box-shadow:0 0 0 3px #17634f16}"
    },
    {
      "name": "Carte",
      "kind": "card",
      "refersTo": "card",
      "description": "Surface de contenu posée sur le papier.",
      "html": "<article class=\"ds-card\"><h3>Décrivez votre besoin</h3><p>Précisez l’achat, le lieu, le délai et votre budget.</p></article>",
      "css": ".ds-card{background:#fff;border:1px solid #e2e8e2;border-radius:13px;padding:24px;box-shadow:0 5px 20px rgb(23 49 34 / .035);font-family:Inter,system-ui,sans-serif}.ds-card h3{margin:0 0 8px;font-size:15px;font-weight:700;color:#20372b;letter-spacing:-.02em}.ds-card p{margin:0;font-size:13px;line-height:1.65;color:#56635c}"
    },
    {
